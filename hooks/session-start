#!/usr/bin/env bash
# SessionStart hook for AI Works (superpowers fork)
# Injects: using-superpowers bootstrap + AI Works identity + in-progress workflow state

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-superpowers content
using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Read AI Works bootstrap content
ai_works_bootstrap_content=$(cat "${PLUGIN_ROOT}/skills/ai-works-bootstrap/SKILL.md" 2>/dev/null || echo "")

# Detect any in-progress workflow state files (docs/ai-works/workflow-state/*.json)
workflow_state_notice=""
WORKFLOW_STATE_DIR="${PLUGIN_ROOT}/docs/ai-works/workflow-state"
if [ -d "${WORKFLOW_STATE_DIR}" ]; then
    state_files=$(find "${WORKFLOW_STATE_DIR}" -name "*.json" -newer "${PLUGIN_ROOT}/package.json" 2>/dev/null | head -5 || true)
    if [ -n "${state_files}" ]; then
        workflow_names=""
        while IFS= read -r f; do
            basename_no_ext="${f##*/}"
            basename_no_ext="${basename_no_ext%-state.json}"
            workflow_names="${workflow_names}  - ${basename_no_ext}\n"
        done <<< "${state_files}"
        workflow_state_notice="\\n<WORKFLOW-RESUME>\\nThe following workflows have in-progress state from a previous session:\\n${workflow_names}\\nTo resume, invoke the workflow-engine skill and load the state file from docs/ai-works/workflow-state/.\\n</WORKFLOW-RESUME>"
    fi
fi

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_superpowers_escaped=$(escape_for_json "$using_superpowers_content")
ai_works_bootstrap_escaped=""
if [ -n "${ai_works_bootstrap_content}" ]; then
    ai_works_bootstrap_escaped=$(escape_for_json "$ai_works_bootstrap_content")
    ai_works_section="\\n\\n**AI Works System — additional skill namespaces and adaptive workflows:**\\n\\n${ai_works_bootstrap_escaped}"
else
    ai_works_section=""
fi

session_context="<EXTREMELY_IMPORTANT>\nYou have superpowers.\n\n**Below is the full content of your 'superpowers:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_superpowers_escaped}${ai_works_section}${workflow_state_notice}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
